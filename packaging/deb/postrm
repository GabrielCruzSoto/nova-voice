#!/usr/bin/env bash
# Debian post-removal script for nova-voice.
set -euo pipefail

if [[ "${1:-}" == "purge" ]]; then
  # Remove global package directory only; user files in $HOME are never touched
  if [[ "$(id -u)" -eq 0 ]]; then
    rm -rf /opt/nova
  else
    rm -rf /opt/nova 2>/dev/null || true
  fi
fi

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database /usr/share/applications || true
fi

exit 0
